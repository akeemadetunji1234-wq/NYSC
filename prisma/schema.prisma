// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Required Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  // Custom Role Field
  role               Role      @default(CORP)
  phone              String?
  whatsapp           String?
  state              String?
  agentVerified      Boolean   @default(false)
  agentVerifiedAt    DateTime?
  verificationStatus String    @default("UNVERIFIED") // UNVERIFIED, PENDING, VERIFIED, REJECTED
  verificationNotes  String?   @db.Text
  isBanned           Boolean   @default(false)
  batch              String? // For Corp members e.g. "Batch A 2026"

  // PPA Location for Corp Members
  ppaState            String?
  ppaLga              String?
  ppaLatitude         Float?
  ppaLongitude        Float?
  lookingForRoommate  Boolean  @default(false)
  roommateBudget      Float?
  roommateGender      String?
  roommatePreferences String?
  createdAt           DateTime @default(now())

  // Agent Application status
  agentRejected   Boolean @default(false)
  rejectionReason String? @db.Text

  // Agent Profile Data
  agency          String?
  experience      String?
  operatingStates String[]
  bio             String?  @db.Text
  docType         String?
  docNumber       String?
  docUrl          String?

  // Premium Subscription
  isPremium     Boolean   @default(false)
  premiumPlan   String? // "CORP_PREMIUM" | "AGENT_PREMIUM"
  premiumSince  DateTime?
  premiumExpiry DateTime? // monthly renewal date

  // Relations
  accounts                Account[]
  sessions                Session[]
  properties              Property[] // Properties hosted by this user (if AGENT)
  bookings                Booking[] // Bookings made by this user (if CORP)
  saved                   SavedProperty[]
  reviews                 Review[] // Reviews left by this user (if CORP)
  viewings                Viewing[] // Viewings scheduled by this user (if CORP)
  sentMessages            Message[]       @relation("SentMessages")
  receivedMessages        Message[]       @relation("ReceivedMessages")
  notifications           Notification[]
  artisans                Artisan[]
  savedSearches           SavedSearch[]
  propertyEvents          PropertyEvent[]
  agentLeads              AgentLead[]     @relation("AgentLeads")
  corpLeads               AgentLead[]     @relation("CorpLeads")
  boostCredits            BoostCredit[]
  artisanReviews          ArtisanReview[]
  submittedListingReports ListingReport[] @relation("ListingReportReporter")

  reportedDisputes Dispute[] @relation("Reporter")
  agentDisputes    Dispute[] @relation("AgentDisputes")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Custom Application Models
enum Role {
  CORP
  AGENT
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

model Property {
  id          String         @id @default(cuid())
  title       String
  description String         @db.Text
  location    String
  state       String
  lga         String?
  latitude    Float?
  longitude   Float?
  price       Float
  bedrooms    Int            @default(1)
  bathrooms   Int            @default(1)
  amenities   String[]
  images      String[]
  videoUrl    String?
  status      PropertyStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  views       Int            @default(0)
  inquiries   Int            @default(0)

  isBoosted    Boolean   @default(false)
  boostedUntil DateTime?
  agentId      String
  agent        User      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  bookings        Booking[]
  savedBy         SavedProperty[]
  reviews         Review[]
  viewings        Viewing[]
  reports         ListingReport[]
  analyticsEvents PropertyEvent[]
  leads           AgentLead[]
  boostCredits    BoostCredit[]
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum FeeStatus {
  UNPAID
  PAID
  HELD_IN_ESCROW
  RELEASED_TO_AGENT
  REFUNDED
}

model Booking {
  id                String        @id @default(cuid())
  propertyId        String
  corpMemberId      String
  date              DateTime
  time              String
  amount            Float         @default(0)
  status            BookingStatus @default(PENDING)
  feeStatus         FeeStatus     @default(UNPAID)
  escrowReleaseDate DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  corpMember User     @relation(fields: [corpMemberId], references: [id], onDelete: Cascade)

  disputes Dispute[]
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  name      String
  state     String?
  lga       String?
  minPrice  Float?
  maxPrice  Float?
  bedrooms  Int?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([state, lga, active])
}

model PropertyEvent {
  id         String   @id @default(cuid())
  propertyId String
  viewerId   String?
  type       String
  dedupeKey  String?  @unique
  metadata   Json?
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewer   User?    @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([propertyId, type, createdAt])
  @@index([viewerId, type, createdAt])
}

model AgentLead {
  id              String    @id @default(cuid())
  agentId         String
  corpMemberId    String
  propertyId      String
  status          String    @default("NEW")
  source          String    @default("PLATFORM")
  message         String?   @db.Text
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  agent      User     @relation("AgentLeads", fields: [agentId], references: [id], onDelete: Cascade)
  corpMember User     @relation("CorpLeads", fields: [corpMemberId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([agentId, status, updatedAt])
  @@index([corpMemberId, createdAt])
  @@index([propertyId, createdAt])
}

model BoostCredit {
  id         String    @id @default(cuid())
  agentId    String
  propertyId String?
  source     String    @default("PLAN")
  status     String    @default("AVAILABLE")
  startsAt   DateTime?
  expiresAt  DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  agent    User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([agentId, status, expiresAt])
  @@index([propertyId, status])
}

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

enum ListingReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model ListingReport {
  id         String              @id @default(cuid())
  propertyId String
  reporterId String
  reason     String
  details    String              @db.Text
  status     ListingReportStatus @default(OPEN)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporter User     @relation("ListingReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([reporterId, createdAt])
}

model Review {
  id           String   @id @default(cuid())
  rating       Int
  comment      String   @db.Text
  reply        String?  @db.Text
  propertyId   String
  corpMemberId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  corpMember User     @relation(fields: [corpMemberId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  content    String   @db.Text
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  read       Boolean  @default(false)

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

enum ViewingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Viewing {
  id           String        @id @default(cuid())
  propertyId   String
  corpMemberId String
  date         DateTime
  time         String
  status       ViewingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  corpMember User     @relation(fields: [corpMemberId], references: [id], onDelete: Cascade)
}

model Artisan {
  id                String          @id @default(cuid())
  name              String
  trade             String // Plumber, Electrician, Carpenter, Painter, AC Technician, Cleaner
  state             String
  lga               String
  phone             String
  rating            Float           @default(5.0)
  verified          Boolean         @default(false)
  verifiedAt        DateTime?
  verificationNotes String?         @db.Text
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  reviews           ArtisanReview[]
}

model ArtisanReview {
  id           String   @id @default(cuid())
  artisanId    String
  corpMemberId String
  rating       Int
  comment      String   @db.Text
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artisan    Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  corpMember User    @relation(fields: [corpMemberId], references: [id], onDelete: Cascade)

  @@unique([artisanId, corpMemberId])
  @@index([artisanId, status, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model EmailOtp {
  id        String   @id @default(cuid())
  email     String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum NotificationType {
  NEW_BOOKING
  BOOKING_STATUS_CHANGE
  NEW_MESSAGE
  NEW_REVIEW
  VIEWING_UPDATE
  AGENT_VERIFIED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

model Dispute {
  id            String        @id @default(cuid())
  bookingId     String
  reporterId    String
  agentId       String
  type          String
  description   String        @db.Text
  adminResponse String?       @db.Text
  status        DisputeStatus @default(OPEN)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reporter User    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  agent    User    @relation("AgentDisputes", fields: [agentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model ContentItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  content   String   @db.Text
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  type         String // Financial, Government, Transport, Utility, etc.
  status       String   @default("Active") // Active, Pending, Inactive
  revenueShare Float    @default(0)
  isGovt       Boolean  @default(false)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
