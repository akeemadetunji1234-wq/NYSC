NEXTAUTH_URL=http://localhost:3000
# Set this only in the deployment secret store; never commit a real value.
NEXTAUTH_SECRET=

# Database
# Set DATABASE_URL only in the deployment secret store; never commit credentials.
DATABASE_URL=

# Mapbox public map token (safe to expose to the browser; restrict its URL origins in Mapbox)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token

# Durable uploads (connect a Vercel Blob store in Vercel; OIDC variables are injected automatically)
# BLOB_STORE_ID=store_xxxxx
# VERCEL_OIDC_TOKEN=...
# BLOB_READ_WRITE_TOKEN=...

# Transactional email via Brevo
# Use a Brevo API key (xkeysib-...) in BREVO_API_KEY, or a Brevo SMTP key in BREVO_SMTP_KEY.
# If an API key is temporarily stored under BREVO_SMTP_KEY, the app recognizes the xkeysib- prefix
# and sends through the Brevo HTTPS API instead of SMTP AUTH.
BREVO_API_KEY=your-brevo-api-key
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=your-brevo-smtp-login
BREVO_SMTP_KEY=your-brevo-smtp-key
BREVO_FROM_EMAIL=hello@your-verified-sender-domain.com
BREVO_FROM_NAME=Neat & Affordable

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Seed Scripts Configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=
USER_PASSWORD=
AGENT_PASSWORD=

# Scheduled route authentication
# Generate a random value of at least 16 characters and set it in Vercel Production and Preview.
CRON_SECRET=replace-with-a-random-32-byte-secret

# Paystack server-side secret key. Add only to Vercel, never expose to the browser or commit a real value.
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Test-only simulated annual premium checkout. Keep disabled in production.
SIMULATED_PAYMENTS_ENABLED=false
SIMULATED_PAYMENTS_ALLOW_PRODUCTION=false

# Safety Flags
ALLOW_DB_RESET=false
ALLOW_DB_SEED=false

# Optional shared rate limiting for multi-instance/serverless deployments
# Leave unset for the bounded local development fallback.
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
