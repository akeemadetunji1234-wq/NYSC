# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-nextauth-string

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Email Provider (e.g. Brevo/Resend)
EMAIL_API_KEY=your-email-provider-api-key
EMAIL_FROM=hello@yourdomain.com

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Seed Scripts Configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-admin-password
USER_PASSWORD=secure-user-password
AGENT_PASSWORD=secure-agent-password

# Safety Flags
ALLOW_DB_RESET=false
ALLOW_DB_SEED=false
